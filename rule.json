{
  "name": "Branch protection — staging (enterprise)",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["staging"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_number_of_approving_reviews",
      "parameters": {
        "required_approving_review_count": 2,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_reviews": true,
        "require_last_push_approval": true,
        "require_review_from_code_owners": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict": true,
        "checks": [
          { "context": "CI / ci" },
          { "context": "lint" },
          { "context": "test" },
          { "context": "build" },
          { "context": "security-scan" },
          { "context": "dependency-review" }
        ]
      }
    },
    {
      "type": "required_linear_history",
      "parameters": {}
    },
    {
      "type": "required_conversation_resolution",
      "parameters": {}
    },
    {
      "type": "required_signed_commits",
      "parameters": {}
    },
    {
      "type": "restrict_deletions",
      "parameters": {}
    },
    {
      "type": "block_force_pushes",
      "parameters": {}
    },
    {
      "type": "restrict_required_pushes",
      "parameters": {
        "apps": [],
        "teams": [],
        "users": []
      }
    },
    {
      "type": "required_first_pull_request_review",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_reviews": true
      }
    }
  ]
}
